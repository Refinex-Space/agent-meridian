<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  AgentMeridian 的 Checkstyle 规则，只检查 src/main。规则来源：编码规范「注释规范」「日志」。
  Javadoc 规则只要求"存在"，中文内容与质量由代码评审保证。格式由 Spotless 负责，这里不重复检查。
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- 禁止 @author 标签：作者信息以 git 历史为准 -->
    <module name="RegexpSingleline">
        <property name="id" value="NoAuthorTag"/>
        <property name="format" value="@author\b"/>
        <property name="message" value="禁止使用 @author 标签（编码规范「不写的注释」）"/>
    </module>

    <module name="TreeWalker">
        <!--
          record 的访问器不要求 Javadoc：组件的含义写在 record 的 Javadoc 中。
          Checkstyle 的 XPath 无法比较两个属性值（属性节点不支持取值，只支持 [@text='字面量'] 形式），
          所以无法精确判断"方法名等于某个组件名"。这里按结构近似：record 中非 static、无参数、方法体只有一条
          return 的方法视为访问器。同形态的派生方法也会被放过，由代码评审兜底。
        -->
        <module name="SuppressionXpathSingleFilter">
            <property name="checks" value="MissingJavadocMethod"/>
            <property name="query" value="//RECORD_DEF/OBJBLOCK/METHOD_DEF[not(PARAMETERS/PARAMETER_DEF) and not(MODIFIERS/LITERAL_STATIC) and count(SLIST/*) = 2 and SLIST/LITERAL_RETURN]"/>
        </module>

        <!-- 禁止通配符导入 -->
        <module name="AvoidStarImport"/>

        <!-- public 与 protected 的类型必须有 Javadoc -->
        <module name="MissingJavadocType">
            <property name="scope" value="protected"/>
            <property name="tokens" value="INTERFACE_DEF, CLASS_DEF, ENUM_DEF, ANNOTATION_DEF, RECORD_DEF"/>
        </module>

        <!-- public 方法必须有 Javadoc；@Override 方法除外（默认 allowedAnnotations） -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="allowMissingPropertyJavadoc" value="false"/>
            <property name="tokens" value="METHOD_DEF, ANNOTATION_FIELD_DEF"/>
        </module>

        <!-- 禁止 System.out、System.err 与 printStackTrace：日志统一用 SLF4J -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoSystemOutErr"/>
            <property name="format" value="\bSystem\s*\.\s*(out|err)\b"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="禁止使用 System.out 与 System.err，改用 SLF4J（编码规范「日志」）"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoPrintStackTrace"/>
            <property name="format" value="\.printStackTrace\s*\("/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="禁止调用 printStackTrace，异常只在边界处理器记录一次日志（编码规范「错误处理」）"/>
        </module>
    </module>
</module>
