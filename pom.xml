<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.refinex.meridian</groupId>
    <artifactId>meridian-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>AgentMeridian</name>
    <description>企业内多租户智能体平台：根 POM，统一构建插件与质量门禁。</description>

    <modules>
        <module>meridian-bom</module>
        <module>meridian-common</module>
        <module>meridian-api</module>
        <module>meridian-security</module>
        <module>meridian-persistence</module>
        <module>meridian-engine-spi</module>
        <module>meridian-engine-agentscope</module>
        <module>meridian-engine-agentscope-test</module>
        <module>meridian-model-client</module>
        <module>meridian-control-plane</module>
        <module>meridian-runtime</module>
        <module>meridian-knowledge</module>
        <module>meridian-test-support</module>
        <module>meridian-arch-tests</module>
    </modules>

    <properties>
        <java.release>25</java.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- JaCoCo 的 prepare-agent 会写入 argLine；未运行 JaCoCo 时保持为空，Surefire 与 Failsafe 通过 @{argLine} 延迟引用 -->
        <argLine />

        <!-- 构建插件版本：取发布满两周的最新稳定版（2026-11-07 核对） -->
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>14.3.0</checkstyle.version>
        <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
        <palantir-java-format.version>2.102.0</palantir-java-format.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <!-- OpenAPI 代码生成（ADR-0029）：7.27.0 发布未满两周（2026-11-02），取 7.26.0（2026-10-06） -->
        <openapi-generator-maven-plugin.version>7.26.0</openapi-generator-maven-plugin.version>

        <!-- 测试过滤：默认排除真实模型测试与 kind 集群测试，live、kind profile 中分别改为只运行它们 -->
        <meridian.test.excludedGroups>live,kind</meridian.test.excludedGroups>
        <!-- domain 包的行覆盖率下限，见架构设计「测试策略」 -->
        <meridian.coverage.domain.minimum>0.80</meridian.coverage.domain.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 依赖版本的唯一来源，见编码规范「依赖管理」 -->
            <dependency>
                <groupId>cn.refinex.meridian</groupId>
                <artifactId>meridian-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          所有模块的测试框架。Surefire 与 Failsafe 按 JUnit 标签排除 live，需要类路径上有 JUnit Platform；
          否则一个空的 target/test-classes 就会让构建报"JUnit 版本过旧"。
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                        </includes>
                        <excludedGroups>${meridian.test.excludedGroups}</excludedGroups>
                        <argLine>@{argLine}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                        <excludedGroups>${meridian.test.excludedGroups}</excludedGroups>
                        <argLine>@{argLine}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <!--
                  从 meridian-api 的 OpenAPI 规范生成代码（ADR-0029）：meridian-api 只生成 DTO，各应用生成自己的服务端接口。
                  这里只放共用的生成选项，生成什么、生成到哪个包由各模块的 execution 决定。
                -->
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${openapi-generator-maven-plugin.version}</version>
                    <configuration>
                        <generatorName>spring</generatorName>
                        <modelPackage>cn.refinex.meridian.api.model</modelPackage>
                        <generateApiTests>false</generateApiTests>
                        <generateModelTests>false</generateModelTests>
                        <generateApiDocumentation>false</generateApiDocumentation>
                        <generateModelDocumentation>false</generateModelDocumentation>
                        <generateSupportingFiles>false</generateSupportingFiles>
                        <configOptions>
                            <useSpringBoot4>true</useSpringBoot4>
                            <useJackson3>true</useJackson3>
                            <!-- 不引入 jackson-databind-nullable：可空字段用 3.1 的 type 数组表达，PATCH 只做"未给出即不变" -->
                            <openApiNullable>false</openApiNullable>
                            <useBeanValidation>true</useBeanValidation>
                            <!-- 不在接口上加 @Validated：参数校验走 Spring 内建的方法校验，失败为 400 而不是 500 -->
                            <useSpringBuiltInValidation>true</useSpringBuiltInValidation>
                            <documentationProvider>none</documentationProvider>
                            <annotationLibrary>none</annotationLibrary>
                            <sourceFolder>src/main/java</sourceFolder>
                            <generateJsonIncludeAnnotations>false</generateJsonIncludeAnnotations>
                            <generateJsonSetterNullsAnnotations>false</generateJsonSetterNullsAnnotations>
                            <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            <!-- 列表与映射字段默认为 null：PATCH 据此区分"未给出"与"给出空值" -->
                            <containerDefaultToNull>true</containerDefaultToNull>
                        </configOptions>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              依赖规则（架构设计「技术基线」「模块依赖规则」「防漂移机制」）。
              默认拒绝：所有 AgentScope 构件与所有平台模块都被禁止，各模块在自己的 POM 中
              向同一个 execution（enforce-rules）的 bannedDependencies/includes 追加允许项。
              includes 会覆盖 excludes，所以允许项只写具体构件，不写通配的 io.agentscope。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-rules</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!-- 架构设计「技术基线」禁止的依赖，所有模块生效 -->
                                        <exclude>org.springframework.ai</exclude>
                                        <exclude>dev.langchain4j</exclude>
                                        <exclude>io.agentscope:*-spring-boot-starter*</exclude>
                                        <exclude>io.agentscope:agentscope-extensions-rag*</exclude>
                                        <exclude>io.agentscope:agentscope-service*</exclude>
                                        <!-- 默认拒绝：只有 engine-agentscope、engine-agentscope-test、runtime、arch-tests 放行具体构件 -->
                                        <exclude>io.agentscope</exclude>
                                        <!-- 默认拒绝：平台模块之间的依赖按「模块依赖规则」在各模块 POM 中放行 -->
                                        <exclude>cn.refinex.meridian</exclude>
                                    </excludes>
                                    <includes>
                                        <!-- 测试夹具模块只能以 test 作用域被依赖 -->
                                        <include>cn.refinex.meridian:meridian-test-support:*:*:test</include>
                                        <include>cn.refinex.meridian:meridian-engine-agentscope-test:*:*:test</include>
                                    </includes>
                                </bannedDependencies>
                                <banDuplicatePomDependencyVersions />
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <removeUnusedImports />
                        <importOrder>
                            <order>\#,</order>
                        </importOrder>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                    </java>
                    <pom>
                        <includes>
                            <include>pom.xml</include>
                            <!-- meridian-bom 不继承本 POM（否则与 BOM 导入形成循环），由根模块代为检查 -->
                            <include>meridian-bom/pom.xml</include>
                        </includes>
                        <sortPom>
                            <nrOfIndentSpace>4</nrOfIndentSpace>
                            <expandEmptyElements>false</expandEmptyElements>
                            <spaceBeforeCloseEmptyElement>true</spaceBeforeCloseEmptyElement>
                        </sortPom>
                    </pom>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/build/checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                    <execution>
                        <id>report-integration</id>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                    <!-- 只统计 domain 包的单元测试覆盖率；模块没有 domain 代码时总行数为 0，检查自然通过 -->
                    <execution>
                        <id>check-domain-coverage</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                        <configuration>
                            <includes>
                                <include>**/domain/**</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${meridian.coverage.domain.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- kind 集群测试：只运行带 kind 标签的 *KindIT，需要本机 kind 集群 meridian 与已部署的沙箱（scripts/dev/deploy-sandbox.sh） -->
        <profile>
            <id>kind</id>
            <properties>
                <meridian.test.excludedGroups />
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes combine.self="override">
                                <include>**/*KindIT.java</include>
                            </includes>
                            <groups>kind</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- 真实模型测试：只运行带 live 标签的 *LiveIT，需要 DASHSCOPE_API_KEY，见测试规范「真实模型测试」 -->
        <profile>
            <id>live</id>
            <properties>
                <meridian.test.excludedGroups />
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes combine.self="override">
                                <include>**/*LiveIT.java</include>
                            </includes>
                            <groups>live</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
