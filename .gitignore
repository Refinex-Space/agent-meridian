# ============================================================
# Java / Maven
# ============================================================
target/
*.class
*.jar
*.war
*.nar
*.ear
!**/src/main/**/*.jar
!**/src/test/**/*.jar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.flattened-pom.xml
.mvn/timing.properties
# Maven Wrapper 3.3+ (only-script) downloads the jar at runtime
.mvn/wrapper/maven-wrapper.jar
# JVM crash logs
hs_err_pid*
replay_pid*
# Heap dumps and JFR recordings
*.hprof
*.jfr
# Gatling load test results
**/gatling/results/

# ============================================================
# Node / pnpm (console/)
# ============================================================
node_modules/
.pnpm-store/
dist/
dist-ssr/
*.tsbuildinfo
.vite/
.eslintcache
.stylelintcache
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ============================================================
# Python / uv (doc-parser/)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version
*.egg-info/
.eggs/
build/
# 仓库根目录的 build/ 存放构建配置（Checkstyle 规则），需要提交
!/build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ============================================================
# Deploy (deploy/)
# ============================================================
# Helm dependency archives; Chart.lock is committed
deploy/helm/**/charts/*.tgz
# Local overrides for Docker Compose
docker-compose.override.yml
compose.override.yaml
# Local data volumes
deploy/compose/data/

# ============================================================
# Secrets and local configuration (never commit)
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
!**/src/test/resources/**/*.jks
application-local.yml
application-local.yaml
application-local.properties
kubeconfig*
*.kubeconfig

# ============================================================
# IDE and editors
# ============================================================
.idea/
*.iml
*.ipr
*.iws
out/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.classpath
.project
.settings/
.factorypath
bin/
.apt_generated/
.sts4-cache/
nbproject/
.nb-gradle/
*.swp
*.swo
*~

# ============================================================
# AI coding assistants (shared config is committed)
# ============================================================
.claude/settings.local.json
CLAUDE.local.md

