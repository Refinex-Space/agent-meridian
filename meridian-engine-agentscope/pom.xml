<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.refinex.meridian</groupId>
        <artifactId>meridian-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>meridian-engine-agentscope</artifactId>

    <name>AgentMeridian Engine AgentScope</name>
    <description>唯一依赖 AgentScope 的生产模块：内核适配层实现。</description>

    <dependencies>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-engine-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-sandbox-kubernetes</artifactId>
        </dependency>
        <!-- 智能体实例缓存的容量与空闲淘汰（架构设计「引擎装配」），版本由 Spring Boot 管理 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-rules</id>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <!-- 按架构设计「模块依赖规则」放行（含传递依赖） -->
                                    <includes combine.children="append">
                                        <include>cn.refinex.meridian:meridian-common</include>
                                        <include>cn.refinex.meridian:meridian-engine-spi</include>
                                        <include>io.agentscope:agentscope-core</include>
                                        <include>io.agentscope:agentscope-harness</include>
                                        <include>io.agentscope:agentscope-extensions-sandbox-kubernetes</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
