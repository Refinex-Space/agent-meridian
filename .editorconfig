# 编辑器统一设置，与 Spotless 的格式一致
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4

[*.xml]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

# 控制台（TypeScript、CSS）按前端惯例两格缩进，与 console/.prettierrc.json 一致
[console/**]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
