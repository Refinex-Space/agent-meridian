<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.refinex.meridian</groupId>
        <artifactId>meridian-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>meridian-security</artifactId>

    <name>AgentMeridian Security</name>
    <description>API Key、OIDC、服务间 JWT；从请求填充 PlatformContext。</description>

    <dependencies>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-api</artifactId>
        </dependency>

        <!-- web 包：请求 ID 与 problem+json。映射逻辑只依赖 spring-web，两种 Web 栈的适配器各自依赖对应模块 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- 两种 Web 栈都是可选依赖：每个应用只带自己的那一种 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- WebFlux 中把 Reactor Context 里的请求 ID 恢复到 MDC -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 按 API Key 限流的令牌桶（ADR-0042）：只有带 Redis 的应用启用 -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- API Key 校验结果的 60 秒缓存（架构设计「认证」）；版本由 Spring Boot 的依赖管理给出 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- 服务 JWT 与 OIDC 令牌的签名校验、JWKS 缓存（ADR-0044） -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
        </dependency>

        <!-- 令牌桶脚本的集成测试：Testcontainers 的 Redis 与 Lettuce 客户端 -->
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-rules</id>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <!-- 按架构设计「模块依赖规则」放行（含传递依赖） -->
                                    <includes combine.children="append">
                                        <include>cn.refinex.meridian:meridian-common</include>
                                        <include>cn.refinex.meridian:meridian-api</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
