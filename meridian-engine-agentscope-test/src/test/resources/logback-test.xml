<?xml version="1.0" encoding="UTF-8"?>
<!-- 测试日志：Spring Boot 测试依赖带来了 Logback，默认的 DEBUG 级别会刷屏；平台类保留 INFO，第三方只留 WARN。 -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="cn.refinex.meridian" level="INFO"/>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
