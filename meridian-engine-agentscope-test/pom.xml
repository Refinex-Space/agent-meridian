<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.refinex.meridian</groupId>
        <artifactId>meridian-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>meridian-engine-agentscope-test</artifactId>

    <name>AgentMeridian Engine AgentScope Test</name>
    <description>ScriptedModel 与内核场景测试夹具，只作为 test 作用域依赖。</description>

    <dependencies>
        <!-- 内存端口夹具实现 engine-spi 的端口、使用 common 的 ID 与异常（ADR-0025） -->
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-engine-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-engine-agentscope</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>

        <!-- Anthropic、Gemini 适配器的模拟供应商（T15a，ADR-0046）；版本在 meridian-bom -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver3</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 断言平台中间件的 span 层级与属性（P13、架构设计「可观测性」），版本由 Spring Boot BOM 管理 -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          P8 预验证与 MCP 客户端的集成测试：进程内的 MCP 服务以 MCP SDK 0.17.2 的 Servlet 传输注册在 Spring Boot 4.1 的
          Spring MVC 应用中（knowledge 服务在 T19 暴露 MCP Server 的方式），版本由 Spring Boot BOM 管理。只在测试中使用。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-rules</id>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <!-- 按架构设计「模块依赖规则」放行（含传递依赖） -->
                                    <includes combine.children="append">
                                        <include>cn.refinex.meridian:meridian-common</include>
                                        <include>cn.refinex.meridian:meridian-engine-spi</include>
                                        <include>cn.refinex.meridian:meridian-engine-agentscope</include>
                                        <include>io.agentscope:agentscope-core</include>
                                        <include>io.agentscope:agentscope-harness</include>
                                        <include>io.agentscope:agentscope-extensions-sandbox-kubernetes</include>
                                        <include>io.agentscope:agentscope-extensions-model-openai</include>
                                        <include>io.agentscope:agentscope-extensions-model-anthropic</include>
                                        <include>io.agentscope:agentscope-extensions-model-gemini</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
