{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(scripts/dev/*)",
      "Bash(scripts/ci/*)",
      "Bash(docker compose *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker exec *)",
      "Bash(docker build *)",
      "Bash(docker info *)",
      "Bash(kind *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(pnpm *)",
      "Bash(uv *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git grep *)",
      "Bash(java *)",
      "Bash(curl *)",
      "Bash(npx *)",
      "Bash(docker run *)",
      "Bash(docker rm *)",
      "Bash(docker images *)",
      "Bash(docker image *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git worktree *)",
      "Bash(git tag *)",
      "Bash(promtool *)",
      "Bash(gitleaks *)",
      "Bash(actionlint *)",
      "Bash(jq *)",
      "Bash(unzip *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(~/.npmrc)",
      "Read(~/.m2/settings-security.xml)",
      "Read(~/.ssh/**)"
    ]
  }
}
