<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.refinex.meridian</groupId>
        <artifactId>meridian-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>meridian-persistence</artifactId>

    <name>AgentMeridian Persistence</name>
    <description>数据源、事务、TenantScopedRepository、outbox。</description>

    <dependencies>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-api</artifactId>
        </dependency>

        <!-- JdbcClient、事务、HikariCP 与数据源自动配置 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- 迁移约定：Flyway 的 schema 与脚本位置由本模块按 meridian.persistence.schema 统一设置 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Redis Stream 与 Pub/Sub，阻塞与响应式两种客户端都基于 Lettuce -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- S3 兼容对象存储：只用同步客户端，排除异步的 Netty 传输 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor.tools</groupId>
            <artifactId>blockhound</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              BlockHound 在运行时重定义 JDK 类：JDK 13 起需要 AllowRedefinitionToAddDeleteMethods；
              它通过 ByteBuddy 动态挂载代理，JDK 21 起需要 EnableDynamicAgentLoading 才不告警。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -XX:+AllowRedefinitionToAddDeleteMethods -XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-rules</id>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <!-- 按架构设计「模块依赖规则」放行（含传递依赖） -->
                                    <includes combine.children="append">
                                        <include>cn.refinex.meridian:meridian-common</include>
                                        <include>cn.refinex.meridian:meridian-api</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
