# 本地开发环境的连接信息与口令，只用于本机的 Docker Compose。
# 复制为同目录的 .env 后按需修改；.env 已被 Git 忽略，不要提交。没有 .env 时 scripts/dev/up.sh 直接使用本文件。

# ---- PostgreSQL ----
# 连接：jdbc:postgresql://localhost:15432/meridian
#   超级用户：只用于初始化与排障
POSTGRES_USER=postgres
POSTGRES_PASSWORD=meridian-local-postgres
#   迁移角色：拥有 cp、rt、kb，Flyway 用它执行 DDL（spring.flyway.user）
MERIDIAN_MIGRATOR_PASSWORD=meridian-local-migrator
#   应用角色：只有 DML，应用运行时使用（spring.datasource.username=meridian_app）
MERIDIAN_APP_PASSWORD=meridian-local-app
MERIDIAN_POSTGRES_PORT=15432

# ---- Redis ----
# 连接：redis://localhost:16379
MERIDIAN_REDIS_PORT=16379

# ---- MinIO（S3 兼容）----
# S3 端点：http://localhost:19000（path-style），控制台：http://localhost:19001
MINIO_ROOT_USER=meridian
MINIO_ROOT_PASSWORD=meridian-local-minio
MERIDIAN_S3_BUCKET=meridian
MERIDIAN_MINIO_PORT=19000
MERIDIAN_MINIO_CONSOLE_PORT=19001

# ---- 身份（T14b，ADR-0044）----
# 控制台用户：auth profile 的 Keycloak（http://localhost:18082，realm meridian-dev，开发用户 dev-admin、dev-developer、dev-viewer，
# 口令 meridian-dev）。管理控制台的引导管理员（http://localhost:18082/admin）：
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=meridian-local-keycloak
MERIDIAN_KEYCLOAK_PORT=18082
# 服务客户端密钥：各服务用它向 control-plane 的 /oauth2/token 换取服务 JWT（至少 16 个字符）。runtime 调 control-plane；
# 出网代理（kind）调 runtime 的出网授权，scripts/dev/deploy-sandbox.sh 把它写进集群的 Secret
MERIDIAN_RUNTIME_CLIENT_SECRET=runtime-local-client-secret
MERIDIAN_EGRESS_PROXY_CLIENT_SECRET=egress-proxy-local-client-secret
# 业务 API Key 由 control-plane 签发：scripts/dev/dev-api-key.sh 建开发租户与项目、创建 Key 并写入 .env 的 MERIDIAN_DEV_API_KEY
# （压测脚本 scripts/perf/capacity.sh 读取它）；本文件不放 Key。

# ---- app profile（T14a）的宿主端口 ----
MERIDIAN_CONTROL_PLANE_PORT=18081
MERIDIAN_RUNTIME_PORT=18080
MERIDIAN_SCRIPTED_MODEL_PORT=18090

# ---- 构建 ----
# 构建 PostgreSQL 镜像需要代理时设置，例如 Docker Desktop 内置代理 http://http.docker.internal:3128
MERIDIAN_DOCKER_BUILD_PROXY=
