<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.refinex.meridian</groupId>
        <artifactId>meridian-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>meridian-runtime</artifactId>

    <name>AgentMeridian Runtime</name>
    <description>运行时应用：会话、事件、SSE、轮次调度、执行智能体、沙箱、模型调用。</description>

    <dependencies>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-api</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-security</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-engine-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-engine-agentscope</artifactId>
        </dependency>
        <!-- runtime 是 WebFlux 应用（架构设计「部署单元」），平台 API 用 Boot 默认的 Jackson 3 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- 健康检查（/actuator/health 与 liveness、readiness 探针），供本地与 Kubernetes 使用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-engine-agentscope-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          runtime 测试开启 BlockHound，检测 Reactor 线程上的阻塞调用（架构设计「测试策略」）。
          blockhound-junit-platform 在 JUnit Platform 启动时自动安装，单元测试与集成测试都生效，不依赖各测试类自己安装。
        -->
        <dependency>
            <groupId>io.projectreactor.tools</groupId>
            <artifactId>blockhound</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor.tools</groupId>
            <artifactId>blockhound-junit-platform</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              BlockHound 在运行时重定义 JDK 类：JDK 13 起需要 AllowRedefinitionToAddDeleteMethods；
              它通过 ByteBuddy 动态挂载代理，JDK 21 起需要 EnableDynamicAgentLoading 才不告警。
              Netty 加载本地传输库调用 System.loadLibrary，JDK 25 把它列为受限方法，需要 enable-native-access（P1 报告）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -XX:+AllowRedefinitionToAddDeleteMethods -XX:+EnableDynamicAgentLoading --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -XX:+AllowRedefinitionToAddDeleteMethods -XX:+EnableDynamicAgentLoading --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-rules</id>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <!-- 按架构设计「模块依赖规则」放行（含传递依赖） -->
                                    <includes combine.children="append">
                                        <include>cn.refinex.meridian:meridian-common</include>
                                        <include>cn.refinex.meridian:meridian-api</include>
                                        <include>cn.refinex.meridian:meridian-security</include>
                                        <include>cn.refinex.meridian:meridian-persistence</include>
                                        <include>cn.refinex.meridian:meridian-engine-spi</include>
                                        <include>cn.refinex.meridian:meridian-engine-agentscope</include>
                                        <include>io.agentscope:agentscope-core</include>
                                        <include>io.agentscope:agentscope-harness</include>
                                        <include>io.agentscope:agentscope-extensions-sandbox-kubernetes</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
