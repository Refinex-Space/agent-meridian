<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.refinex.meridian</groupId>
        <artifactId>meridian-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>meridian-api</artifactId>

    <name>AgentMeridian API</name>
    <description>OpenAPI 规范与生成的 DTO，不含服务端接口。</description>

    <dependencies>
        <dependency>
            <groupId>cn.refinex.meridian</groupId>
            <artifactId>meridian-common</artifactId>
        </dependency>

        <!-- 生成的 DTO 用到的注解：Bean Validation、@Generated、Spring 的 @Nullable 与 @DateTimeFormat（ADR-0029） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- 规范校验与兼容性检查（OpenApiSpecTest、OpenApiCompatibilityTest） -->
        <dependency>
            <groupId>org.openapitools.openapidiff</groupId>
            <artifactId>openapi-diff-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 只生成 DTO（cn.refinex.meridian.api.model），服务端接口由各应用自己生成（架构设计「仓库布局」） -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-dto</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/meridian-v1.yaml</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <generateApis>false</generateApis>
                            <generateModels>true</generateModels>
                            <!-- 3.1 的"二者之一"的原始类型（文本或数组）生成器处理不了，DTO 中用 Object，由 runtime 按类型分派 -->
                            <schemaMappings>EmbeddingInput=java.lang.Object,EmbeddingVector=java.lang.Object,ResponseInput=java.lang.Object,ResponseInputContent=java.lang.Object</schemaMappings>
                            <configOptions>
                                <useSealed>true</useSealed>
                            </configOptions>
                        </configuration>
                    </execution>
                    <!-- 管理 API（控制台使用）的 DTO，包与公开 API 分开（ADR-0042） -->
                    <execution>
                        <id>generate-admin-dto</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/meridian-admin-v1.yaml</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <modelPackage>cn.refinex.meridian.api.admin.model</modelPackage>
                            <generateApis>false</generateApis>
                            <generateModels>true</generateModels>
                        </configuration>
                    </execution>
                    <!-- 内部接口（服务之间调用）的 DTO，包与公开 API 分开（ADR-0033） -->
                    <execution>
                        <id>generate-internal-dto</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/meridian-internal-v1.yaml</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <modelPackage>cn.refinex.meridian.api.internal.model</modelPackage>
                            <generateApis>false</generateApis>
                            <generateModels>true</generateModels>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-rules</id>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <!-- 按架构设计「模块依赖规则」放行（含传递依赖） -->
                                    <includes combine.children="append">
                                        <include>cn.refinex.meridian:meridian-common</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
